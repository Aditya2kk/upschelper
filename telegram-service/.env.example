# Telegram MTProto API Credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session string (generated after running: npm run auth)
TELEGRAM_SESSION=

# Channel to fetch newspapers from (without @)
TELEGRAM_CHANNEL=your_channel_handle

# Where to save downloaded PDFs
PDF_OUTPUT_DIR=../frontend/public/newspapers

# Fetch schedule (cron expression) — default: every day at 6:30 AM IST
FETCH_CRON=30 1 * * *

# How many recent messages to scan for PDFs
FETCH_MESSAGE_LIMIT=300
